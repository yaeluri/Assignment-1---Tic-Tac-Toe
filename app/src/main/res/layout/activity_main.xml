<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Player X's turn"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:rowCount="3"
        android:columnCount="3"
        android:useDefaultMargins="true">

        <Button android:id="@+id/btn0" style="@style/TttCell" />
        <Button android:id="@+id/btn1" style="@style/TttCell" />
        <Button android:id="@+id/btn2" style="@style/TttCell" />

        <Button android:id="@+id/btn3" style="@style/TttCell" />
        <Button android:id="@+id/btn4" style="@style/TttCell" />
        <Button android:id="@+id/btn5" style="@style/TttCell" />

        <Button android:id="@+id/btn6" style="@style/TttCell" />
        <Button android:id="@+id/btn7" style="@style/TttCell" />
        <Button android:id="@+id/btn8" style="@style/TttCell" />
    </GridLayout>

    <Button
        android:id="@+id/btnPlayAgain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Play Again"
        android:enabled="false"
        android:alpha="0.5"
        android:padding="14dp" />

</LinearLayout>
